# Absolute path of the git repo the team works on (must have ≥1 commit, checked out on baseBranch)
PROJECT_DIR=/home/you/code/my-project
# Your host user (output of `id -u` / `id -g`) so the container can write to PROJECT_DIR
CREW_UID=1000
CREW_GID=1000
# Opus head authentication (one of the two)
ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=
#CREW_PORT=4317
